# Unity + DRPC library source
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
# Adapted: keep *.csproj / solution files (packable .NET projects live here).

.utmp/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]in/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
*.log

# Blender backup (Unity importer may create these)
*.blend1
*.blend1.meta

# Autogenerated JetBrains Rider plugin (if Assets/ layout is used)
[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Visual Studio / Rider cache
.vs/
.idea/
.gradle/

# Autogenerated VS/MD/Consulo junk (do NOT ignore *.csproj — those are source)
ExportedObj/
.consulo/
*.unityproj
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta for debug symbols
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash / Mono
sysinfo.txt
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics
crashlytics-build.properties

# TestRunner
InitTestScene*.unity*

# Addressables defaults
ServerData/
[Aa]ssets/StreamingAssets/aa*
[Aa]ssets/AddressableAssetsData/link.xml*
[Aa]ssets/Addressables_Temp*
[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers/
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Play mode test scenes / scene cache
[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
[Aa]ssets/[Ss]ceneDependencyCache*

# Unity .meta must be tracked (root VisualStudio.gitignore has *.meta)
!*.meta
!*.meta/
